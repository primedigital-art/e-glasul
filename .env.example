# Șablon de variabile de mediu. Copiază în .env (ignorat de git) și completează.
# NICIODATĂ service_role aici sau în orice fișier tracked — vezi .claude/rules/security.md.

# Supabase local (valorile default ale `supabase start`; harness-ul de test le folosește implicit)
SUPABASE_API_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_ANON_KEY=
