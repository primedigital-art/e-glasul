# LF is the repository truth. CI runs on Linux; force LF in the working tree on every
# platform so a Windows checkout does not rewrite files to CRLF and silently break
# tooling (e.g. scripts/list-tasks.mjs parsing task frontmatter).
*.md    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
# Source formatted by Biome (lineEnding: lf) — keep LF so `pnpm lint` passes on any checkout.
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.astro text eol=lf
*.css   text eol=lf
